{
  "name": "tu-rest-rs",
  "version": "0.1.0",
  "description": "",
  "main": "index.node",
  "scripts": {
    "test": "cargo test",
    "cargo-build": "tsc && cargo build --message-format=json-render-diagnostics > cargo.log",
    "cross-build": "tsd && cross build --message-format=json-render-diagnostics > cross.log",
    "postcargo-build": "neon dist < cargo.log",
    "postcross-build": "neon dist -m /target < cross.log",
    "debug": "npm run cargo-build --",
    "build": "npm run cargo-build -- --release --offline",
    "cross": "npm run cross-build -- --release"
  },
  "author": "Tonni Diaz",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@neon-rs/cli": "0.1.82"
  }
}
