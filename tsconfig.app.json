{
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts",
        "preload.d.ts",
        "rs/bindings/*.ts"
    ],
    "exclude": [
        "src/**/__tests__/*",
        "backend/**/*",
        "node_modules",
        "rs/lib/",
        "rs/target/",
        "rs/dist/",
        "rs/test/",
        "rs/src/"
    ],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "composite": true,
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "preserve",
        "strict": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": false,
        "noImplicitThis": true,
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    }
}